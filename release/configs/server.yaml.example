# =====================================================================
# ToShell Team Server 配置文件模板（开源示例）
# 复制为 server.yaml 后按需修改；部署前请务必更改所有敏感项。
#   Linux/macOS:  cp configs/server.yaml.example configs/server.yaml
#   Windows:      copy configs\server.yaml.example configs\server.yaml
# =====================================================================

auth:
    # 管理员密码：可填 bcrypt 哈希($2a$...)或明文，明文会被自动哈希。默认 toshell，部署后请立即修改。
    admin_password: toshell
    admin_username: admin
    api_key_enabled: true
    # API Key：调用 API 时用 X-API-Key 请求头传递；务必改为你自己的随机串（可以配多个）。
    api_keys:
        - change-me-api-key
    enabled: true
    jwt_enabled: true
    jwt_expire: 24
    # JWT 签名密钥：留空首次启动会自动生成并写回；也可手填 32 字节随机串。
    jwt_key: ""

database:
    database: toshell
    host: ""
    password: ""
    path: ./data/toshell.db
    port: 5432
    ssl_mode: disable
    type: sqlite
    username: ""

implant:
    # 心跳间隔(秒)与抖动(%)：载荷构建不指定时取这里的值。
    # 5 秒固定轮询是最典型的 C2 行为特征，默认给 60s ± 20%；
    # 对时效要求高的场景可调小，但建议保持 >= 15s 且抖动 >= 20%。
    interval: 60
    jitter: 20
    kill_date: ""
    output_dir: ./implants
    retry_count: 3
    retry_wait: 5
    working_hours: ""
    # 启动随机延迟（秒）：植入端启动后随机休眠 [min,max] 秒，打乱"启动即行为"的检测节奏。
    # 生成载荷时可在页面上覆盖（页面留 0 = 用这里的值；0 不会关闭延迟，想几乎零延迟填 1/1）。
    startup_delay_min: 2
    startup_delay_max: 10

builder:
    # C 植入端（约 50KB）编译所需的 mingw-w64 gcc。留空时自动探测：
    # 环境变量 TOSHELL_MINGW_GCC / CC / MINGW_HOME / MSYS2_ROOT / MINGW_PREFIX →
    # 服务端同目录便携工具链（如 ./mingw64/bin/gcc.exe）→ 常见安装目录
    # （MSYS2/TDM-GCC/Chocolatey/Scoop）→ PATH → Windows 注册表 PATH。
    # 可填 gcc 可执行文件路径、所在目录，或 PATH 中的命令名。
    mingw_gcc_path: ""

    # ── 代码签名（Authenticode，Windows 载荷可选）────────────────────────
    # 为什么需要：装有 360/电脑管家等国产安全软件的主机上，**未签名的新 PE 往往在
    # 进程创建阶段就被拒绝执行并删除**（实测连 Hello-World 程序也一样，而微软签名的
    # notepad.exe 副本可正常执行）。签名不是免杀银弹（杀软还会看信誉与行为），
    # 但它是"能不能跑起来"这一层的敲门砖。
    #
    # 证书二选一（pfx 优先）：
    #   sign_pfx_path + sign_pfx_password：用证书文件签名（密码通过环境变量传给子进程，
    #     不会出现在命令行里）；
    #   sign_thumbprint：用本机证书存储 CurrentUser\My 里该指纹的证书签名（EV/硬件
    #     令牌场景更标准；有 signtool.exe 时优先用它，否则回退 PowerShell）。
    # 自签名证书（仅测试；目标机需导入受信任根，签名才会显示 Valid）：
    #   New-SelfSignedCertificate -Type CodeSigningCert -Subject "CN=YourName" `
    #     -KeyUsage DigitalSignature -KeySpec Signature `
    #     -CertStoreLocation Cert:\CurrentUser\My -NotAfter (Get-Date).AddYears(3)
    #   导出 pfx：$c = Get-ChildItem Cert:\CurrentUser\My\<指纹>; `
    #     Export-PfxCertificate -Cert $c -FilePath .\codesign.pfx `
    #     -Password (ConvertTo-SecureString '你的密码' -AsPlainText -Force)
    sign_enabled: false
    sign_pfx_path: ""
    sign_pfx_password: ""
    sign_thumbprint: ""
    # 时间戳服务器（可选）：留空则不时间戳；内网/离线环境通常不可达，失败不影响签名本身
    sign_timestamp_url: ""
    # signtool.exe 路径（可选）：留空自动探测 PATH 与 Windows SDK 目录
    sign_signtool_path: ""
    # 写入签名的描述（可选）
    sign_description: ""
    # true：签名失败就丢弃该载荷（构建报错）；false：只告警并返回未签名产物
    sign_fail_closed: false

listener:
    cert_file: ""
    enabled: true
    # 植入端加密密钥（AES-256）：留空首次启动自动生成；更换后需重新生成所有植入端。
    encryption_key: ""
    front_domain: ""
    heartbeat_timeout: 60s
    host: 0.0.0.0
    key_file: ""
    mimicry_profile: cdn
    mimicry_site: ""
    port: 8080
    protocol: tcp
    # 公网地址（服务器公网 IP/域名），生成的植入端连接它。
    public_host: 127.0.0.1
    tls_enabled: false
    write_queue_size: 8192
    mqtt_broker_url: ""
    mqtt_topic_prefix: toshell
    mqtt_embedded_broker: false

logging:
    compress: true
    format: json
    level: info
    max_age: 30
    max_backups: 10
    max_size: 100
    output: stdout

server:
    api_host: 0.0.0.0
    api_port: 18081
    host: 0.0.0.0
    idle_timeout: 120s
    max_connections: 1000
    port: 8080
    read_timeout: 30s
    tls_cert: ""
    tls_key: ""
    trust_proxy_headers: false
    write_timeout: 30s

webhook:
    # 自动识别平台：钉钉(dingtalk)/飞书(open.feishu.cn)/企业微信(qyapi.weixin.qq.com)/Slack/Discord；
    # 也可显式指定 auto|dingtalk|feishu|wecom|slack|discord|generic。
    # secret 为各平台的加签密钥（钉钉走 URL 参数，飞书走 body 内 timestamp+sign）。
    content: "new session online: {hostname} ({username}@{os}/{arch}) from {remote_addr}"
    enabled: false
    format: auto
    only_online: true
    secret: ""
    url: ""

ai:
    enabled: false
    # OpenAI 兼容的 chat/completions 端点（如 https://api.deepseek.com/v1）。
    base_url: ""
    api_key: ""
    model: deepseek-chat
    timeout: 60
    max_turns: 20
    # 异步自主 Agent 并发上限（同时进行的任务数，默认 2，范围 1-8）。每个任务起一个 goroutine，超出则排队。
    agent_concurrency: 2
    # 工具下载域名白名单（远程下载 remote_download 只能从这些域名拉取；留空=允许任意公网域名，
    # 但始终拒绝内网/回环地址，防 SSRF）。
    download_allowlist: []
    # 权限模式：auto=全自动（默认，工具直接执行）；normal=影响会话的操作（下发/文件/进程/凭据/截屏/隧道/插件）
    # 执行前需用户同意（副驾驶会拦截并请求确认；任务流(delegate/剧本)除外）。
    consent_mode: auto

# ── Web 控制台防护（防资产测绘 / 防未授权访问）────────────────────────
# 在控制台与全部管理 API 前加一道认证门槛，阻止 Fofa/Quake/Hunter 等资产测绘
# 引擎抓取并收录本资产。仅作用于控制台端口；植入端回连 /api/v1/implant/* 与
# C2 监听器端口完全不受影响，已持有 API Key / JWT 的脚本与 AI 调用照常放行。
web:
    # 是否启用基础认证。默认 false（不影响升级）；开启前请先填好用户名与密码。
    basic_auth_enabled: false
    basic_auth_user: toshell
    # 密码：保存时自动 bcrypt 哈希（也可直接填 $2a$ 开头的哈希）。
    # 建议在「设置 → 安全 → 防资产测绘」里填写，避免明文落在文件里。
    basic_auth_password: ""
    # 未认证响应方式：
    #   basic    = 401 + WWW-Authenticate（浏览器弹出认证框，前端照常可用，默认）
    #   disguise = 纯 404 伪装（不留任何 C2 特征，测绘引擎看到"无此服务"）
    # disguise 模式下浏览器不会弹认证框，请配合下面的 stealth_key 或在入口路径输入凭据。
    unauth_mode: basic
    # 可选：替换控制台首页标题，避免默认标题暴露用途。
    decoy_title: ""
    # 可选：控制台来源白名单（CIDR）。非空时仅这些网段可访问，可在公网部署时把控制台
    # 限制在运维网段（需自行确保不会把自己挡在外面）。
    allow_cidrs: []
    # 隐蔽入口密钥（disguise 模式必填，否则浏览器无法进入控制台）：
    #   浏览器访问 http://<host>:18081/__gate?k=<stealth_key> 即种下入口 Cookie（30 天），
    #   之后前端与 API 凭 Cookie 通行，/ 及其他路径对未持凭据者仍是 404。
    #   也可直接访问 /__gate，由浏览器弹框输入上面的用户名/密码进入。
    #   可在设置页「生成」按钮随机生成（hex，URL 安全）。
    stealth_key: ""
    # 入口 Cookie 名（一般无需修改）。
    stealth_cookie: tsh_gate
    # 入口路径 /__gate 是否返回 401 挑战（便于浏览器弹框）。设为 false 则只能用密钥链接进入，
    # 线上不会出现任何 401 响应。
    entry_challenge: true
# ─── 对外 MCP（Model Context Protocol）服务端 ───────────────────────────────
# 让外部 MCP 客户端（Claude Desktop / Cursor / 自研 Agent）用标准协议调用本项目的工具。
# 安全前置：MCP 客户端一旦连上，就等于拿到调用内部工具的能力（与内置 AI 副驾驶同一张工具表）。
#   因此默认关闭；开启后也只绑回环地址、必须配置 token，且默认只放行只读工具。
#   不要把 MCP 端点暴露到公网；跨机访问请走堡垒机 / SSH 端口转发。
mcp:
    # 是否启动 MCP 服务端（默认 false）。
    enabled: false
    # 监听地址（默认只绑回环；改成 0.0.0.0 前请确认风险与访问控制）。
    bind: 127.0.0.1:18082
    # 访问令牌：请求头 Authorization: Bearer <token> 或 X-MCP-Token。
    # 留空时即使 enabled=true 也会拒绝启动（fail-closed，不允许无鉴权裸奔）。
    token: ""
    # 允许通过 MCP 调用的工具白名单；留空 = 仅只读工具（注册表 read 级）。
    # 危险级（exec/credentials/fileless_exec/plugin_load/delegate 等）不建议放进来。
    allowed_tools: []
    # 允许的浏览器 Origin（留空 = 拒绝所有带 Origin 的跨域请求）。
    allowed_origins: []
    # 允许访问 MCP 的来源网段（CIDR 或裸 IP；留空 = 不限制来源）。不读 X-Forwarded-For，避免伪造绕过。
    allow_cidrs: []
    # 每 token 每分钟请求上限（<=0 取默认 60，不是不限；符合 fail-closed 口径）。
    max_rpm: 120
    # 同时执行的工具调用上限（<=0 取默认 4）。
    max_concurrent: 4
    # 每 token 未读完的外置结果句柄上限（<=0 取默认 32）：拿了句柄不读又继续调用会先撞这道闸。
    max_pending_handles: 32
    # 结果内联上限（字节）：超出则外置到 result_dir，只回句柄 + 摘要（截断会显式标注）。
    inline_limit: 8192
    # 大结果外置目录与保留时长。
    result_dir: ./data/mcp-results
    result_ttl: 24h
    # 审计日志（JSONL；参数只记摘要，不记原文）。
    audit_path: ./logs/mcp-audit.jsonl
    # 出错即拒（默认 true）。
    fail_closed: true